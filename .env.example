# Recognition API URL (for handwriting recognition)
INK_RECOGNITION_API_URL=

# OpenRouter API key (for LLM inference)
# Get your key at https://openrouter.ai/keys
INK_OPENROUTER_API_KEY=
# Optional: use a dedicated multimodal model for diagrams, tables, and screenshots
# Higher accuracy: google/gemini-2.5-pro
# Lower cost / faster: google/gemini-2.5-flash
# INK_OPENROUTER_VISION_MODEL=google/gemini-2.5-pro
# Optional: set these for OpenRouter leaderboard attribution
# INK_OPENROUTER_SITE_URL=https://your-site.com
# INK_OPENROUTER_SITE_NAME=Ink Playground

# fal.ai API key (for AI sketch image generation)
# Get your key at https://fal.ai/dashboard/keys
INK_FAL_AI_API_KEY=

# Gemini API key (for AI image generation)
# Get your key at https://aistudio.google.com/apikey
INK_GEMINI_API_KEY=

# Local app backend
PORT=3001
DATABASE_URL=postgres://postgres:postgres@localhost:5433/obsidianink
LOCAL_UPLOAD_DIR=./data/uploads

# Ollama (primary local AI)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text

# OpenRouter fallback for research answers
OPENROUTER_LLMCHAT_API_KEY=
OPENROUTER_LLMCHAT_MODEL=
